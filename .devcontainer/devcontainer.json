{
    "name":  "The Impostor Protocol",
    "image":  "mcr.microsoft.com/devcontainers/javascript-node:22",
    "postCreateCommand":  "npm ci \u0026\u0026 npm run build",
    "postStartCommand":  "nohup sh -c \u0027PORT=3000 node dist/server/index.mjs\u0027 \u003e /tmp/server.log 2\u003e\u00261 \u0026",
    "forwardPorts":  [
                         3000
                     ],
    "portsAttributes":  {
                            "3000":  {
                                         "label":  "The Impostor Protocol",
                                         "onAutoForward":  "notify"
                                     }
                        },
    "features":  {
                     "ghcr.io/devcontainers/features/sshd:1":  {
                                                                   "version":  "latest"
                                                               }
                 }
}
