generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A guest profile. The raw token only ever lives in the player's httpOnly cookie;
/// only its SHA-256 hash is stored here.
model Guest {
  id          String   @id @default(cuid())
  publicId    String   @unique
  tokenHash   String   @unique
  displayName String
  avatar      String   @default("visor")
  xp          Int      @default(0)
  gamesPlayed Int      @default(0)
  wins        Int      @default(0)
  stats       Json     @default("{}")
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  achievements Achievement[]
  matches      MatchPlayer[]

  @@index([xp(sort: Desc)])
}

model Achievement {
  id         String   @id @default(cuid())
  guestId    String
  key        String
  unlockedAt DateTime @default(now())
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId, key])
}

model Match {
  id          String        @id @default(cuid())
  roomCode    String
  environment String
  winner      String
  reason      String
  playerCount Int
  durationSec Int
  teamScore   Int
  startedAt   DateTime
  endedAt     DateTime      @default(now())
  players     MatchPlayer[]
}

model MatchPlayer {
  id       String  @id @default(cuid())
  matchId  String
  guestId  String
  name     String
  role     String
  faction  String
  alive    Boolean
  won      Boolean
  xpEarned Int
  missions Int     @default(0)
  kills    Int     @default(0)
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  guest    Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([matchId, guestId])
  @@index([guestId])
}
