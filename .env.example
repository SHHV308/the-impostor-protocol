# Copy to .env for local development. Never commit the real .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string. If omitted the server falls back to an
# in-memory store (progression is lost on restart) and logs a warning.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/impostor?schema=public

# Public origin of the app, used for CORS in development and invite links.
# Leave empty in production when the server serves the client itself.
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 to shorten match timers (used by automated tests only).
FAST_TIMERS=0
